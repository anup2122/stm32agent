{
  // Schema version for stm32-tools.local.jsonc. Options: 1.
  "version": 1,
  // Machine-local tool discovery overrides. Supported keys: "cube_programmer", "cubeide", "cubemx", "stlink_gdb_server", "arm_gdb".
  "tools": {
    // STM32CubeProgrammer CLI discovery settings used for flash, memory, and core-control operations.
    "cube_programmer": {
      // Environment variable checked before config candidates and PATH lookup. Default: "STM32_PROGRAMMER_CLI_PATH".
      "env_var": "STM32_PROGRAMMER_CLI_PATH",
      // Executable or launcher name used for PATH lookup when no explicit path candidate resolves.
      "executable_name": "STM32_Programmer_CLI.exe",
      // Per-platform candidate paths checked before generic PATH fallback. Supported keys: "windows", "linux", "darwin".
      "candidates": {
        // Ordered candidate paths checked on windows hosts.
        "windows": [
          "C:/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe"
        ],
        // Ordered candidate paths checked on linux hosts.
        "linux": [
          "/opt/st/stm32cubeprogrammer/bin/STM32_Programmer_CLI"
        ],
        // Ordered candidate paths checked on darwin hosts.
        "darwin": [
          "/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/MacOs/bin/STM32_Programmer_CLI"
        ]
      }
    },
